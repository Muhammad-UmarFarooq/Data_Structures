class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class Solution:
    def length(self, head):
        count = 0
        temp = head
        while temp:
            count += 1
            temp = temp.next
        return count

head = Node(1)
head.next = Node(2)
head.next.next = Node(3)
head.next.next.next = Node(4)

obj = Solution()
print(obj.length(head))
